# hugo: Ignore output directory.
out/
public

# hugo: Ignore generated resources.
.hugo_build.lock
resources/_gen
site/resources/_gen

# hugo: Ignore binary assets (synced to / served from the GCS bucket).
# Fonts are fetched into this tree by `task assets:fonts:download`. Per-item
# images live under site/assets/{projects,posts}/<item-id>/. These are exactly
# the trees the sync tasks mirror — keep in agreement with ASSETS_REMOTE_DIRS
# in Taskfile.yml.
site/assets/images
site/assets/fonts
site/assets/projects
site/assets/posts

# agent: Ignore per-agent scratch / research.
.agents/
